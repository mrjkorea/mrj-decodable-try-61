    },
    {
      "page_id": "p03",
      "text": "Twice each day the sea creeps up the beach, then slides back, like a heart beat.",
      "image": "books/mlr_dec_063/pages/p03.webp",
      "audio": "books/mlr_dec_063/audio/pages/p03.mp3",
      "duration_ms": 6295,
      "voice": "57785406027844b29b63a772a8477bc2",
