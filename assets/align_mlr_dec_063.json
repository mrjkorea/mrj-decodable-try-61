      "song_audio": "books/mlr_dec_063/audio/song/p04.mp3",
      "song_duration_ms": 8411
    },
    {
      "page_id": "p05",
      "text": "Waves are made by wind. Each wave lifts the sea and beats at the beach.",
      "image": "books/mlr_dec_063/pages/p05.webp",
      "audio": "books/mlr_dec_063/audio/pages/p05.mp3",
      "duration_ms": 6138,
      "voice": "57785406027844b29b63a772a8477bc2",
