    },
    {
      "page_id": "p07",
      "text": "In wet weather, get your head ready: a hood. In cold weather, a sweater. In hot weather, a hat instead.",
      "image": "books/mlr_dec_073/pages/p07.webp",
      "audio": "books/mlr_dec_073/audio/pages/p07.mp3",
