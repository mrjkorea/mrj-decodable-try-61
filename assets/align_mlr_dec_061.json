      "song_audio": "books/mlr_dec_061/audio/song/p07.mp3",
      "song_duration_ms": 9482
    },
    {
      "page_id": "p08",
      "text": "A long trail can take days and days, so hikers sleep in tents by the trail.",
      "image": "books/mlr_dec_061/pages/p08.webp",
      "audio": "books/mlr_dec_061/audio/pages/p08.mp3",
