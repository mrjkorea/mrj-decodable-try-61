      "song_duration_ms": 7026
    },
    {
      "page_id": "p07",
      "text": "Some old train rails are trails now. The trains went, and the flat trail stays for miles.",
      "image": "books/mlr_dec_061/pages/p07.webp",
      "audio": "books/mlr_dec_061/audio/pages/p07.mp3",
      "duration_ms": 7836,
