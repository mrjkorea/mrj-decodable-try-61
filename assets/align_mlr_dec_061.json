      "song_duration_ms": 7810
    },
    {
      "page_id": "p09",
      "text": "Paint can not talk, but a blaze tells you: stay on the trail. Hikers who stray trample plants.",
      "image": "books/mlr_dec_061/pages/p09.webp",
      "audio": "books/mlr_dec_061/audio/pages/p09.mp3",
