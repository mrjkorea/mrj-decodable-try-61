      "song_audio": "books/mlr_dec_077/audio/song/p04.mp3",
      "song_duration_ms": 8646
    },
    {
      "page_id": "p05",
      "text": "Fear starts in the ear. A sharp sound near you makes you jump before you think.",
      "image": "books/mlr_dec_077/pages/p05.webp",
      "audio": "books/mlr_dec_077/audio/pages/p05.mp3",
      "duration_ms": 6556,
      "voice": "57785406027844b29b63a772a8477bc2",
