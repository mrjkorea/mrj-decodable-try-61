    },
    {
      "page_id": "p04",
      "text": "Ears never shut. All year, all night, they hear: hearing is the guard that wakes you.",
      "image": "books/mlr_dec_077/pages/p04.webp",
      "audio": "books/mlr_dec_077/audio/pages/p04.mp3",
      "duration_ms": 7366,
      "voice": "57785406027844b29b63a772a8477bc2",
