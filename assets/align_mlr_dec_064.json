    },
    {
      "page_id": "p03",
      "text": "Bright light can harm your sight. Do not look right at the sun, even with an eye shut tight.",
      "image": "books/mlr_dec_064/pages/p03.webp",
      "audio": "books/mlr_dec_064/audio/pages/p03.mp3",
      "duration_ms": 7209,
