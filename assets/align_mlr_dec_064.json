      "page_id": "p02",
      "text": "Nothing is faster than light. Sunlight makes its flight from high up in under ten minutes.",
      "image": "books/mlr_dec_064/pages/p02.webp",
      "audio": "books/mlr_dec_064/audio/pages/p02.mp3",
