      "song_audio": "books/mlr_dec_078/audio/song/p08.mp3",
      "song_duration_ms": 7392
    },
    {
      "page_id": "p09",
      "text": "Knit, knuckle, knapsack, knack. The kn club is small, and you know most of it.",
      "image": "books/mlr_dec_078/pages/p09.webp",
      "audio": "books/mlr_dec_078/audio/pages/p09.mp3",
      "duration_ms": 7836,
