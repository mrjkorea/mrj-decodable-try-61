    },
    {
      "page_id": "p04",
      "text": "In old talk, wr meant a twist: a wrist twists, and a wrench twists!",
      "image": "books/mlr_dec_079/pages/p04.webp",
      "audio": "books/mlr_dec_079/audio/pages/p04.mp3",
