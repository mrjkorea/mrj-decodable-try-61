      "song_audio": "books/mlr_dec_079/audio/song/p04.mp3",
      "song_duration_ms": 7497
    },
    {
      "page_id": "p05",
      "text": "A wrist is a twisting joint: it lets a hand wrap, wring and write.",
      "image": "books/mlr_dec_079/pages/p05.webp",
      "audio": "books/mlr_dec_079/audio/pages/p05.mp3",
