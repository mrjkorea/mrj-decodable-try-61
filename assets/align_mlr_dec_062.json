    },
    {
      "page_id": "p03",
      "text": "A sheep can see in back of it with no turn of its neck. Not a lot gets past a sheep.",
      "image": "books/mlr_dec_062/pages/p03.webp",
      "audio": "books/mlr_dec_062/audio/pages/p03.mp3",
      "duration_ms": 6556,
