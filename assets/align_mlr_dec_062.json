      "song_duration_ms": 8411
    },
    {
      "page_id": "p04",
      "text": "Sheep keep in a flock. When one flees, the rest flee, and not one checks why.",
      "image": "books/mlr_dec_062/pages/p04.webp",
      "audio": "books/mlr_dec_062/audio/pages/p04.mp3",
      "duration_ms": 7314,
      "voice": "57785406027844b29b63a772a8477bc2",
