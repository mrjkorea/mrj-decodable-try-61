      "song_audio": "books/mlr_dec_074/audio/song/p08.mp3",
      "song_duration_ms": 9064
    },
    {
      "page_id": "p09",
      "text": "Below the snow it is warm. A mouse tunnels below a low snow bank as a crow shivers on a branch.",
      "image": "books/mlr_dec_074/pages/p09.webp",
      "audio": "books/mlr_dec_074/audio/pages/p09.mp3",
      "duration_ms": 8202,
      "voice": "57785406027844b29b63a772a8477bc2",
