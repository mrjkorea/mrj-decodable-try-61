    },
    {
      "page_id": "p03",
      "text": "Snow falls slow, as a flake is mostly holes. A bowl of snow melts to just a little water.",
      "image": "books/mlr_dec_074/pages/p03.webp",
      "audio": "books/mlr_dec_074/audio/pages/p03.mp3",
      "duration_ms": 8202,
