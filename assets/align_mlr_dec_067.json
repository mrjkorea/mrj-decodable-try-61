      "page_id": "p01",
      "text": "A cook book is a book that tells a cook what to do.",
      "image": "books/mlr_dec_067/pages/p01.webp",
      "audio": "books/mlr_dec_067/audio/pages/p01.mp3",
      "duration_ms": 4388,
