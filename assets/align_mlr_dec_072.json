      "song_duration_ms": 10135
    },
    {
      "page_id": "p07",
      "text": "At dusk, dim light drains shades and all things go grey. They hunt then, and grey prey freezes.",
      "image": "books/mlr_dec_072/pages/p07.webp",
      "audio": "books/mlr_dec_072/audio/pages/p07.mp3",
