      "song_duration_ms": 10318
    },
    {
      "page_id": "p08",
      "text": "Ships and planes get grey paint, so they blend in. Grey hides big things as well as prey.",
      "image": "books/mlr_dec_072/pages/p08.webp",
      "audio": "books/mlr_dec_072/audio/pages/p08.mp3",
      "duration_ms": 7993,
